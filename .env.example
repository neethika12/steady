# Copy this file to ".env" to change any value. Everything here is optional:
# "docker compose up --build" works without a .env file.
# Placeholders only. Never commit a real .env file.

# --- Database (only reachable inside the Docker network) ---
POSTGRES_USER=steady
POSTGRES_PASSWORD=change-me
POSTGRES_DB=steady

# --- Ports on this computer (always bound to 127.0.0.1) ---
FRONTEND_PORT=5173
BACKEND_PORT=8000

# --- Calendar days ---
# Used only the first time the app starts with an empty database.
# After that, change the timezone in the app's Settings.
DEFAULT_TIMEZONE=UTC

# --- Local AI (Ollama running on this computer; no API key exists) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=phi4-mini
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=700
AI_MAX_RETRIES=1
AI_REQUESTS_PER_MINUTE=6

# --- Accounts ---
# Session cookies are HTTPS-only unless this is false (compose.yaml sets false for local http).
COOKIE_SECURE=false
# Local only: the first account created takes over data from before accounts existed.
CLAIM_EXISTING_DATA=true
# Set to false to stop new sign-ups.
SIGNUP_ENABLED=true
SESSION_DAYS=30
# Hosted servers without a local model: set to false to hide the AI features.
AI_ENABLED=true
